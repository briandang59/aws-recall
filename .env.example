# Leave all values empty for browser-local demo mode.
# Choose ONE Google auth method below.
GOOGLE_SHEET_ID=

# Option A: OAuth web client (your client_secret_*.json).
# On Vercel: set redirect URI to https://YOUR-DOMAIN/api/auth/google/callback.
# Add the exact same URL in Google Cloud > OAuth client > Authorized redirect URIs.
# Then sign in to the app and click Connect Google. No localhost setup required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional: run npm run google:connect to store a server-side refresh token instead.
GOOGLE_REFRESH_TOKEN=

# Option B: service account. Share your Sheet with this email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value, keeping literal \n inside the quoted string.
GOOGLE_PRIVATE_KEY=

# Required when Google Sheets is connected. Use a long, unique password.
APP_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
